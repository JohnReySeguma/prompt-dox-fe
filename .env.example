# Copy to .env.local and fill in. See README.md and API_CONTRACT.md §1.

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js. Generate a secret with `npx auth secret`.
AUTH_SECRET=

# Google OAuth web client. AUTH_GOOGLE_ID must equal the backend's GOOGLE_CLIENT_ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
